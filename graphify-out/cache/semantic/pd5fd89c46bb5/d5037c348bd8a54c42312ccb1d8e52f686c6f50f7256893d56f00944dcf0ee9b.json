{"nodes": [{"id": "cv_experience_bank_readme_experience_bank", "label": "Experience Bank (CV content pool)", "file_type": "concept", "source_file": "cv/experience_bank/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acts as the single source of truth for CV tailoring so the tailoring step can verify claims against real experience; inventing content in the bank would defeat the safety design. Deliberately holds more content than fits one page - the tailoring step decides what makes the cut per job. Skills must carry evidence (never a bare list) and each achievement lives in exactly one file to avoid duplication."}, {"id": "cv_experience_bank_readme_base_cv_template", "label": "Base CV Visual Template (base_cv.html)", "file_type": "concept", "source_file": "cv/experience_bank/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates visual template (fonts, layout, colors, section order) from the content pool so tailored CVs reuse consistent styling with swapped-in content."}, {"id": "cv_experience_bank_readme_cv_tailoring", "label": "CV Tailoring Process", "file_type": "rationale", "source_file": "cv/experience_bank/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads a job's requirements, picks the most relevant bank entries, and produces new HTML from the base template. Scans YAML frontmatter at runtime so no manifest file needs maintaining; priority field (1-3) and lowercase hyphen-separated tags drive selection."}], "edges": [{"source": "cv_experience_bank_readme_cv_tailoring", "target": "cv_experience_bank_readme_experience_bank", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "cv/experience_bank/README.md", "source_location": null, "weight": 1.0}, {"source": "cv_experience_bank